{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MaliciousFlow canvas analysis batch",
  "type": "object",
  "required": [
    "schemaVersion",
    "caseId",
    "expectedRevision",
    "requestId",
    "addresses",
    "transfers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "addresses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/address"
      }
    },
    "transfers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transfer"
      }
    },
    "balances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/balance"
      }
    }
  },
  "$defs": {
    "address": {
      "type": "object",
      "required": [
        "id",
        "address",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "integer"
        },
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        }
      }
    },
    "transfer": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "hash",
        "time",
        "asset",
        "assetId",
        "amount",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "usd": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "evidence": {
          "type": "string"
        },
        "rawAmount": {
          "type": "string",
          "pattern": "^[0-9]*$"
        },
        "verification": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "balance": {
      "type": "object",
      "required": [
        "addressId",
        "assetId",
        "asset",
        "amount",
        "time",
        "source"
      ],
      "properties": {
        "addressId": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "usd": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "revision",
        "added",
        "duplicates",
        "refs"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
